# Copy to .env and fill in. Never commit .env.

# SEL node to read from.
SEL_NODE=staging.toronto.togather.foundation

# Admin credentials. Optional — without them the dashboard runs in public-only
# mode and the admin panels report as unavailable rather than failing.
#
# These are held by the BFF process only. Per docs/rfc-001-auth-posture.md they
# are never sent to the browser in any form.
SEL_ADMIN_EMAIL=
SEL_ADMIN_PASSWORD=

# Listen address. The MVP has no browser-facing authentication, so the process
# refuses to bind anywhere but loopback unless you explicitly override it.
DASHBOARD_ADDR=127.0.0.1:8080

# Timezone used to bucket events into days.
DASHBOARD_TZ=America/Toronto
